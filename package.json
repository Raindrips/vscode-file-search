{
    "name": "vscode-file-search",
    "publisher": "Raindrips",
    "displayName": "File Search",
    "description": "Search workspace files by name in a dedicated sidebar view.",
    "version": "0.2.0",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "search",
        "file search",
        "project search",
        "quick open"
    ],
    "activationEvents": [
        "onView:projectFileSearch.filesView"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Raindrips/vscode-file-search.git"
    },
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "projectFileSearchContainer",
                    "title": "File Search",
                    "icon": "media/search.svg"
                }
            ]
        },
        "views": {
            "projectFileSearchContainer": [
                {
                    "id": "projectFileSearch.filesView",
                    "name": "Files",
                    "type": "webview",
                    "contextualTitle": "File Search"
                }
            ]
        },
        "commands": [
            {
                "command": "projectFileSearch.search",
                "title": "Search Project Files",
                "category": "File Search",
                "icon": "$(search)"
            },
            {
                "command": "projectFileSearch.refresh",
                "title": "Refresh File Index",
                "category": "File Search",
                "icon": "$(refresh)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "projectFileSearch.refresh",
                    "when": "view == projectFileSearch.filesView",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "projectFileSearch.search",
                "key": "ctrl+alt+p",
                "when": "workspaceFolderCount > 0"
            }
        ],
        "configuration": {
            "title": "File Search",
            "properties": {
                "projectFileSearch.include": {
                    "type": "array",
                    "default": [
                        "**/*"
                    ],
                    "description": "Glob patterns for included files."
                },
                "projectFileSearch.exclude": {
                    "type": "array",
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**"
                    ],
                    "description": "Glob patterns for excluded files."
                },
                "projectFileSearch.maxResults": {
                    "type": "number",
                    "default": 300,
                    "minimum": 10,
                    "maximum": 2000,
                    "description": "Maximum number of files listed in the search view. Narrow the query to see more precise results."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/minimatch": "^5.1.2",
        "@types/node": "^20.19.43",
        "@types/vscode": "^1.90.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "fuse.js": "^6.6.2",
        "minimatch": "^10.2.5"
    },
    "icon": "icon.png"
}
